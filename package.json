{
	"name": "soy-web-development",
	"version": "0.1.0",
	"description": "Custom WordPress theme con Tailwind y bloques de Gutenberg.",
	"private": true,
	"scripts": {
		"build:blocks": "wp-scripts build",
		"start:blocks": "wp-scripts start",
		"build:css": "tailwindcss -i ./src/tailwind.css -o ./build/tailwind.css --minify",
		"watch:css": "tailwindcss -i ./src/tailwind.css -o ./build/tailwind.css --watch",
		"build": "npm-run-all --serial build:blocks build:css",
		"dev": "npm-run-all --parallel start:blocks watch:css",
		"lint:js": "wp-scripts lint-js",
		"lint:php": "vendor/bin/phpcs",
		"lint:php:fix": "vendor/bin/phpcbf",
		"check:tokens": "node scripts/check-tokens.mjs",
		"format": "wp-scripts format",
		"optimize:images": "node scripts/optimize-images.mjs",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": "wp-scripts lint-js",
		"*.php": "vendor/bin/phpcs --standard=.phpcs.xml.dist",
		"*.json": "wp-scripts format"
	},
	"devDependencies": {
		"@wordpress/scripts": "^30.0.0",
		"autoprefixer": "^10.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.5",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.4.0",
		"sharp": "^0.34.5",
		"tailwindcss": "^3.4.0"
	}
}
