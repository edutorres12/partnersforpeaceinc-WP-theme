{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "soywd/tag-list",
	"title": "Tag list",
	"category": "soywd",
	"icon": "tag",
	"description": "List of pills/tags. Each one accepts an optional URL.",
	"keywords": [ "tags", "chips", "pills", "specialties" ],
	"version": "0.1.0",
	"textdomain": "soywd",
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"className": true,
		"spacing": { "padding": true, "margin": true },
		"color": { "background": true, "text": true }
	},
	"attributes": {
		"items": {
			"type": "array",
			"default": [
				{ "label": "Specialty 1", "url": "" },
				{ "label": "Specialty 2", "url": "" },
				{ "label": "Specialty 3", "url": "" }
			]
		},
		"alignment": {
			"type": "string",
			"default": "center",
			"enum": [ "left", "center", "right" ]
		},
		"variant": {
			"type": "string",
			"default": "outline",
			"enum": [ "outline", "filled" ]
		},
		"pillBorderColor": { "type": "string", "default": "" },
		"rowBreak": { "type": "number", "default": 0 }
	},
	"editorScript": "file:./index.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
