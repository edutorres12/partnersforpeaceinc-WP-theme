# Copy to `.env` and fill in the blanks. `.env` is gitignored — never commit it.
#
# These mirror the secrets and variables that
# `.github/workflows/deploy-content.yml` reads in CI. Having them locally is what
# lets you inspect the live site directly — `scripts/wp-remote.sh` reads this
# file — instead of pushing a commit and reading a workflow log.
#
# Nothing here is a substitute for the GitHub secrets: CI does not see this file.
# Writes should still go through the workflow, where they are logged and the
# database is backed up first.

# hPanel → Advanced → SSH Access prints the whole line:
#   ssh uXXXXXXXXX@123.45.67.89 -p 65002
HOSTINGER_HOST=
HOSTINGER_USER=
HOSTINGER_PORT=65002

# Private half of the deploy key. Its public half is the one pasted into
# hPanel → SSH Access. `~` is expanded.
HOSTINGER_SSH_KEY_PATH=~/.ssh/hostinger_pfp_deploy

# Absolute path to the WordPress root on the server, e.g.
# /home/u123456789/domains/example.com/public_html
WP_PATH=

# Theme path, relative to WP_PATH.
THEME_DIR=wp-content/themes/partnersforpeace
