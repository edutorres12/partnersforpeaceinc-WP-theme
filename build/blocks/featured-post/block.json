{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wptpl/featured-post",
  "title": "Featured post",
  "category": "wptpl",
  "icon": "star-filled",
  "description": "The headline blog post — the sticky post if there is one, otherwise the most recent — rendered as the large accent card.",
  "keywords": [
    "blog",
    "featured",
    "post",
    "sticky"
  ],
  "version": "0.1.0",
  "textdomain": "wptpl",
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "className": true,
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "attributes": {},
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}